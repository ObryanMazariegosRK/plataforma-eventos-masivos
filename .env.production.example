# =============================================================================
# Variables de PRODUCCIÓN para docker-compose.prod.yml (Coolify).
# En Coolify se pegan en la pestaña "Environment Variables" del recurso; este archivo
# es solo la lista explicada. NUNCA subas los valores reales al repositorio.
# Guía completa: docs/DESPLIEGUE.md
# =============================================================================

# ---- Aplicación ----
# Genérala UNA vez en tu computadora y guárdala: docker compose exec app php artisan key:generate --show
APP_KEY=
# La dirección pública, con https (para la prueba: el dominio gratuito de sslip.io)
APP_URL=https://soiree.20.7.59.197.sslip.io

# ---- Base de datos (inventa contraseñas largas y distintas; nunca "root" ni "secret") ----
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Usuario de la bitácora (solo puede leer y agregar registros)
BITACORA_DB_PASSWORD=

# ---- Correo por Gmail ----
# Cuenta de Gmail con verificación en 2 pasos y una "contraseña de aplicación"
# (https://myaccount.google.com/apppasswords): 16 letras, escríbelas SIN espacios.
MAIL_USERNAME=tu.cuenta@gmail.com
MAIL_PASSWORD=
# Gmail solo deja enviar como la misma cuenta
MAIL_FROM_ADDRESS=tu.cuenta@gmail.com
MAIL_FROM_NAME=Soirée

# ---- Marca ----
# Correo de contacto que aparece en el pie de página, la política de privacidad y los correos
MARCA_CONTACTO=tu.cuenta@gmail.com

# ---- Notificaciones push ----
# Llaves propias del servidor. Genéralas en tu computadora SIN tocar tu .env:
#   docker compose exec app php artisan webpush:vapid --show
# La privada nunca va a Git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: si se deja vacío usa mailto:MARCA_CONTACTO
VAPID_SUBJECT=

# ---- Google (opcional) ----
# Los mismos de tu .env local. En la consola de Google agrega la URL de retorno:
#   https://soiree.20.7.59.197.sslip.io/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: si se deja vacío se arma con APP_URL + /auth/google/callback
GOOGLE_REDIRECT_URI=

# ---- Opcionales ----
# Dirección que llevan los QR de los boletos (vacío = APP_URL)
BOLETOS_URL_PUBLICA=
# Horas máximas de una sesión
AUTH_TOKEN_HORAS=12
LOG_LEVEL=warning
